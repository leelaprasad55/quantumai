APP_ENV=development

# Backend-only secrets. Never put these in React/Vite variables.
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key
IBM_QUANTUM_INSTANCE=your_ibm_quantum_instance_crn
QBRAID_API_KEY=your_qbraid_api_key
GROQ_API_KEY=your_groq_api_key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_SHOTS=4096
MAX_QUBITS=20
MAX_CODE_LENGTH=12000
EXECUTION_TIMEOUT=10
RATE_LIMIT_PER_MINUTE=30
